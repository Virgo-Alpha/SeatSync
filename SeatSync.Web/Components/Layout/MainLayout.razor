@implements IDisposable
@inherits LayoutComponentBase
@inject IUserSessionService Session
@inject NavigationManager Nav

<div class="app-shell">
    <header class="app-top px-4">
        <a class="landing-brand" href="/">SeatSync</a>
        @if (Session.IsAuthenticated)
        {
            <a class="landing-login" href="/logout">Logout</a>
        }
        else if (IsLandingPage)
        {
            <a class="landing-login" href="/login">Login</a>
        }
    </header>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += HandleSessionChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);
    private void HandleLocationChanged(object? _, LocationChangedEventArgs __) => InvokeAsync(StateHasChanged);

    private bool IsLandingPage
    {
        get
        {
            var relativePath = Nav.ToBaseRelativePath(Nav.Uri).Trim('/');
            return string.IsNullOrWhiteSpace(relativePath);
        }
    }
}
