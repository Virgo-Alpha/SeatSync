@page "/"

<PageTitle>SeatSync</PageTitle>

<div class="landing">
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero__content">
            <p class="eyebrow">SeatSync</p>
            <h1 id="hero-title">Sell out events without overselling seats</h1>
            <p>
                SeatSync helps event teams publish events, reserve seats safely during checkout, and deliver receipts immediately.
            </p>
            <div class="hero__actions">
                <a class="cta cta--primary" href="/events">Book Seats</a>
                <a class="cta cta--secondary" href="/admin/events">Admin: Create Event</a>
            </div>
        </div>
        <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=1200&q=80" alt="Concert stage with crowd lights" />
    </section>

    <section class="about" id="about" aria-labelledby="about-title">
        <h2 id="about-title">Built for speed and reliability</h2>
        <p>
            Real-time reservation states reduce checkout conflicts and keep seat inventory accurate for both admins and attendees.
        </p>
        <div class="about__grid">
            <article>
                <h3>Event-first booking</h3>
                <p>Users choose the event first, then reserve seats tied to that event only.</p>
            </article>
            <article>
                <h3>Hold then pay</h3>
                <p>Seats are held when users proceed to payment, preventing accidental double-booking.</p>
            </article>
            <article>
                <h3>Receipt PDF delivery</h3>
                <p>After payment, users receive a receipt number and can open/download the PDF receipt.</p>
            </article>
        </div>
    </section>

    <section class="testimonials" aria-labelledby="testimonials-title">
        <h2 id="testimonials-title">What teams say</h2>
        <div class="testimonials__grid">
            <blockquote>
                “We reduced checkout complaints by over 40% after moving to held-seat checkout.”
                <cite>Venue Ops Lead</cite>
            </blockquote>
            <blockquote>
                “Admins can publish events and seat maps in minutes. It’s straightforward.”
                <cite>Festival Coordinator</cite>
            </blockquote>
            <blockquote>
                “The receipt flow is clear for attendees and support staff.”
                <cite>Customer Success Manager</cite>
            </blockquote>
        </div>
    </section>

    <section class="gallery" aria-label="SeatSync highlights">
        <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1200&q=80" alt="Audience enjoying a live event" />
        <img src="https://images.unsplash.com/photo-1507878866276-a947ef722fee?auto=format&fit=crop&w=1200&q=80" alt="Hands raised at a concert venue" />
    </section>

    <footer class="site-footer" aria-label="Site footer">
        <p><strong>SeatSync</strong> | Reliable seat reservations for live events.</p>
        <p>
            <a href="/events">Browse events</a> |
            <a href="/login">Sign in</a>
        </p>
    </footer>
</div>
