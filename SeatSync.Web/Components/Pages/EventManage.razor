@page "/admin/events"
@rendermode InteractiveServer
@inject ISeatSyncApiClient ApiClient
@inject IUserSessionService Session
@inject NavigationManager Nav

<PageTitle>Manage Events</PageTitle>

<div class="event-manage-page">
    <div class="event-manage-header">
        <h1>Manage events</h1>
        @if (CanManage)
        {
            <button class="admin-button" type="button" @onclick="@(() => Nav.NavigateTo("/admin/events/new"))">Create event</button>
        }
    </div>

    @if (!Session.IsAuthenticated)
    {
        <p class="status-message status-message--error">Sign in as a manager to access event administration.</p>
    }
    else if (!CanManage)
    {
        <p class="status-message status-message--error">Only admins and organizers can manage events.</p>
    }
    else if (_isLoading)
    {
        <p class="status-message">Loading events...</p>
    }
    else if (_events.Count == 0)
    {
        <p>No events yet. Create your first event.</p>
    }
    else
    {
        <section class="event-grid" aria-label="Manageable events">
            @foreach (var ev in _events)
            {
                <article class="event-card">
                    <h2>@ev.Name</h2>
                    <p class="event-meta">@ev.StartsAt.ToLocalTime().ToString("dddd, MMM d yyyy h:mm tt")</p>
                    @if (!string.IsNullOrWhiteSpace(ev.Agenda))
                    {
                        <p>@ev.Agenda</p>
                    }

                    <div class="event-actions">
                        <button class="event-action-button" type="button" @onclick="@(() => Nav.NavigateTo($"/admin/events/{ev.Id}/reservations"))">View reservations</button>
                        <button class="event-action-button" type="button" @onclick="@(() => Nav.NavigateTo($"/admin/events/{ev.Id}/edit"))">Edit event</button>
                        <button class="event-action-button event-action-button--danger" type="button" @onclick="@(() => StartDelete(ev))">Delete event</button>
                    </div>

                    @if (_deleteTargetId == ev.Id)
                    {
                        <section class="delete-confirm" aria-label="Delete confirmation">
                            <p>Step 1: confirm deletion intent.</p>
                            <button class="event-action-button event-action-button--danger" type="button" @onclick="EnableDeleteVerification">Continue delete</button>

                            @if (_showDeleteVerification)
                            {
                                <p>Step 2: type <strong>DELETE</strong> to permanently remove this event.</p>
                                <InputText class="form-control" @bind-Value="_deleteVerificationText" />
                                <div class="delete-actions">
                                    <button class="event-action-button event-action-button--danger"
                                            type="button"
                                            disabled="@(!string.Equals(_deleteVerificationText, "DELETE", StringComparison.Ordinal))"
                                            @onclick="DeleteEventAsync">
                                        Confirm delete
                                    </button>
                                    <button class="event-action-button" type="button" @onclick="CancelDelete">Cancel</button>
                                </div>
                            }
                        </section>
                    }
                </article>
            }
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="@(_isError ? "status-message status-message--error" : "status-message status-message--success")">@_status</p>
    }
</div>

@code {
    private List<EventApiModel> _events = [];
    private bool _isLoading = true;
    private string _status = string.Empty;
    private bool _isError;

    private Guid? _deleteTargetId;
    private bool _showDeleteVerification;
    private string _deleteVerificationText = string.Empty;

    private bool CanManage => Session.IsInRole("Admin") || Session.IsInRole("Organizer");

    protected override async Task OnInitializedAsync()
    {
        await ReloadEventsAsync();
    }

    private async Task ReloadEventsAsync()
    {
        _isLoading = true;
        _events = (await ApiClient.GetEventsAsync(CancellationToken.None))
            .OrderBy(x => x.StartsAt)
            .ToList();
        _isLoading = false;
    }

    private void StartDelete(EventApiModel ev)
    {
        _deleteTargetId = ev.Id;
        _showDeleteVerification = false;
        _deleteVerificationText = string.Empty;
    }

    private void EnableDeleteVerification()
    {
        _showDeleteVerification = true;
    }

    private void CancelDelete()
    {
        _deleteTargetId = null;
        _showDeleteVerification = false;
        _deleteVerificationText = string.Empty;
    }

    private async Task DeleteEventAsync()
    {
        if (!_deleteTargetId.HasValue)
        {
            return;
        }

        _status = string.Empty;
        _isError = false;

        var deleted = await ApiClient.DeleteEventAsync(_deleteTargetId.Value, CancellationToken.None);
        if (!deleted)
        {
            _isError = true;
            _status = "Failed to delete event.";
            return;
        }

        _status = "Event deleted.";
        CancelDelete();
        await ReloadEventsAsync();
    }
}
