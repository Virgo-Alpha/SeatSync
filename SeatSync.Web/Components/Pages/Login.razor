@page "/login"
@rendermode InteractiveServer
@inject ISeatSyncApiClient ApiClient
@inject IUserSessionService Session
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="login-page">
    <h1>Login</h1>

    <div class="login-toggle" role="group" aria-label="Login profile">
        <button type="button"
                class="login-toggle__button @(_selectedProfile == LoginProfile.Attendee ? "is-active" : string.Empty)"
                @onclick="@(() => SetProfile(LoginProfile.Attendee))">
            Attendee
        </button>
        <button type="button"
                class="login-toggle__button @(_selectedProfile == LoginProfile.Admin ? "is-active" : string.Empty)"
                @onclick="@(() => SetProfile(LoginProfile.Admin))">
            Admin
        </button>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" />
        </div>

        <div class="mb-3">
            <label>Password</label>
            <InputText class="form-control" type="password" @bind-Value="_model.Password" />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@_isLoading">@(_isLoading ? "Signing in..." : "Sign in")</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="text-danger mt-3">@_error</p>
    }
</div>

@code {
    private readonly LoginFormModel _model = new();
    private LoginProfile _selectedProfile = LoginProfile.Attendee;
    private bool _isLoading;
    private string _error = string.Empty;

    protected override void OnInitialized()
    {
        SetProfile(LoginProfile.Attendee);
    }

    private void SetProfile(LoginProfile profile)
    {
        _selectedProfile = profile;
        if (profile == LoginProfile.Admin)
        {
            _model.Email = "admin@seatsync.demo";
            _model.Password = "demo123";
            return;
        }

        _model.Email = "attendee@seatsync.demo";
        _model.Password = "demo123";
    }

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _error = string.Empty;

        try
        {
            var result = await ApiClient.LoginAsync(_model.Email, _model.Password, CancellationToken.None);
            if (result is null)
            {
                _error = "Invalid credentials.";
                return;
            }

            Session.SetUser(new AuthenticatedUserModel(
                result.UserId,
                result.DisplayName,
                result.Email,
                result.Role,
                result.AccessToken,
                result.ExpiresAtUtc));

            var target = string.Equals(result.Role, "Admin", StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(result.Role, "Organizer", StringComparison.OrdinalIgnoreCase)
                ? "/admin/events"
                : "/events";

            Nav.NavigateTo(target);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class LoginFormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private enum LoginProfile
    {
        Attendee,
        Admin
    }
}
