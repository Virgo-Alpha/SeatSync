@page "/seating"
@page "/seating/{EventId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject ISeatSyncApiClient ApiClient
@inject IUserSessionService Session
@inject ICheckoutFlowState CheckoutFlow
@inject NavigationManager Nav

<PageTitle>Seating Chart</PageTitle>

<div class="venue-page">
    <h1>Seating Chart</h1>

    @if (EventId == Guid.Empty)
    {
        <p class="status-message status-message--error">Choose an event before selecting seats.</p>
        <button class="reserve-button" type="button" @onclick="@(() => Nav.NavigateTo("/events"))">Choose event</button>
    }
    else
    {
        <p>
            @if (_activeEvent is not null)
            {
                <span>Event: <strong>@_activeEvent.Name</strong> on @_activeEvent.StartsAt.ToLocalTime().ToString("MMM d yyyy h:mm tt")</span>
            }
        </p>

        @if (!Session.IsAuthenticated)
        {
            <p class="status-message status-message--error">Please login to reserve seats.</p>
            <button class="reserve-button" type="button" @onclick="@(() => Nav.NavigateTo("/login"))">Go to Login</button>
        }
        else
        {
            <div class="venue-shell">
                <header class="stage">STAGE</header>

                <div class="venue-markers venue-markers--top">
                    <span class="marker marker--fire">FIRE ESCAPE LEFT</span>
                    <span class="marker marker--fire">FIRE ESCAPE RIGHT</span>
                </div>

                <div class="seating-lane">
                    @if (_isLoading)
                    {
                        <p class="status-message">Loading seats...</p>
                    }
                    else if (_seats.Count == 0 && !_isErrorMessage && string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <p class="status-message status-message--error">No seats were returned by the backend API.</p>
                    }
                    else
                    {
                        <SeatingChart Seats="_seats" SeatsChanged="OnSeatsChanged" />
                    }
                </div>

                <div class="venue-markers venue-markers--bottom">
                    <span class="marker marker--entry">ENTRY A</span>
                    <span class="marker marker--entry">ENTRY B</span>
                    <span class="marker marker--exit">EXIT A</span>
                    <span class="marker marker--exit">EXIT B</span>
                </div>
            </div>

            <p class="selection-summary">
                Selected Seats: @_seats.Count(s => s.State == SeatVisualState.Selected)
            </p>

            <button class="reserve-button"
                    type="button"
                    disabled="@(_isLoading || _isSubmitting || !_seats.Any(s => s.State == SeatVisualState.Selected))"
                    @onclick="ProceedToPaymentAsync">
                @(_isSubmitting ? "Reserving..." : "Proceed to payment")
            </button>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="@GetStatusCssClass()">@_statusMessage</p>
    }
</div>

@code {
    [Parameter]
    public Guid EventId { get; set; }

    private List<SeatViewModel> _seats = [];
    private EventApiModel? _activeEvent;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string _statusMessage = string.Empty;
    private bool _isErrorMessage;

    protected override void OnInitialized()
    {
        Session.Changed += HandleSessionChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadSeatMapAsync(preserveStatusMessage: false);
    }

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
    }

    private void HandleSessionChanged()
    {
        _ = LoadSeatMapAsync(preserveStatusMessage: true);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadSeatMapAsync(bool preserveStatusMessage)
    {
        _isLoading = true;
        if (!preserveStatusMessage)
        {
            _statusMessage = string.Empty;
            _isErrorMessage = false;
        }

        if (EventId == Guid.Empty)
        {
            _activeEvent = null;
            _seats = [];
            _isLoading = false;
            return;
        }

        try
        {
            var events = await ApiClient.GetEventsAsync(CancellationToken.None);
            _activeEvent = events.FirstOrDefault(x => x.Id == EventId);
            if (_activeEvent is null)
            {
                _seats = [];
                _statusMessage = "This event no longer exists.";
                _isErrorMessage = true;
                return;
            }

            var seats = await ApiClient.GetSeatsAsync(EventId, CancellationToken.None);
            _seats = seats
                .Select(MapApiSeatToViewModel)
                .ToList();
        }
        catch (HttpRequestException)
        {
            _seats = [];
            _isErrorMessage = true;
            _statusMessage = "Cannot reach SeatSync API. Start SeatSync.Api (or docker compose) and refresh.";
        }
        catch (TaskCanceledException)
        {
            _seats = [];
            _isErrorMessage = true;
            _statusMessage = "SeatSync API request timed out. Please retry.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnSeatsChanged(IReadOnlyList<SeatViewModel> _)
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ProceedToPaymentAsync()
    {
        if (!Session.IsAuthenticated || EventId == Guid.Empty || _activeEvent is null)
        {
            return;
        }

        var selectedSeatIds = _seats
            .Where(s => s.State == SeatVisualState.Selected && s.BackendSeatId.HasValue)
            .Select(s => s.BackendSeatId!.Value)
            .ToList();

        var selectedSeatLabels = _seats
            .Where(s => s.State == SeatVisualState.Selected)
            .Select(s => $"{s.Row}{s.Number}")
            .OrderBy(x => x)
            .ToList();

        if (selectedSeatIds.Count == 0)
        {
            return;
        }

        _isSubmitting = true;
        _statusMessage = string.Empty;

        try
        {
            var holdResult = await ApiClient.CreateHoldAsync(EventId, selectedSeatIds, CancellationToken.None);

            if (!holdResult.IsSuccess || !holdResult.HoldId.HasValue || !holdResult.ExpiresAt.HasValue)
            {
                _statusMessage = holdResult.IsConflict
                    ? "Reservation conflict: one or more seats are no longer available."
                    : holdResult.Message ?? "Failed to reserve seats for payment.";
                _isErrorMessage = true;
                await LoadSeatMapAsync(preserveStatusMessage: true);
                return;
            }

            CheckoutFlow.Set(new PendingCheckoutModel(
                holdResult.HoldId.Value,
                EventId,
                _activeEvent.Name,
                _activeEvent.StartsAt,
                selectedSeatLabels,
                holdResult.ExpiresAt.Value));

            Nav.NavigateTo($"/checkout/{holdResult.HoldId.Value}");
        }
        catch (HttpRequestException)
        {
            _isErrorMessage = true;
            _statusMessage = "Reservation failed because SeatSync API is unreachable.";
        }
        catch (TaskCanceledException)
        {
            _isErrorMessage = true;
            _statusMessage = "Reservation request timed out. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static SeatViewModel MapApiSeatToViewModel(SeatApiModel seat) => new()
    {
        BackendSeatId = seat.Id,
        Section = seat.Section,
        Row = seat.Row,
        Number = seat.Number,
        State = seat.State switch
        {
            0 => SeatVisualState.Available,
            1 => SeatVisualState.Held,
            2 => SeatVisualState.Booked,
            _ => SeatVisualState.Available
        }
    };

    private string GetStatusCssClass() =>
        _isErrorMessage
            ? "status-message status-message--error"
            : "status-message status-message--success";
}
