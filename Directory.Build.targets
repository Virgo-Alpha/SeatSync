<Project>
  <!--
    Intentionally present to stop MSBuild from searching parent folders for
    Directory.Build.targets on CI agents.
  -->

  <!--
    Defensive CI hardening for C# compile inputs only.
    Some CI import chains can leak literal wildcard identities into @(Compile),
    which Roslyn then treats as filenames (CS2021/CS2001).
  -->
  <Target Name="SanitizeInvalidLiteralCompileItems" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_InvalidCompileItems Include="@(Compile)"
                            Condition="('%(Compile.Identity)' == '**/*.cs' or '%(Compile.Identity)' == '**\*.cs')
                                       and !Exists('%(Compile.FullPath)')" />

      <Compile Remove="@(_InvalidCompileItems)" />
      <_ProgramCompile Include="@(Compile)" Condition="'%(Compile.Filename)%(Compile.Extension)' == 'Program.cs'" />
    </ItemGroup>

    <Message Importance="high"
             Condition="'@(_InvalidCompileItems)' != ''"
             Text="Sanitized invalid literal compile items: @(_InvalidCompileItems, ', ')" />

    <Warning Condition="'$(MSBuildProjectName)' == 'SeatSync.Api' and '@(_ProgramCompile)' == ''"
             Text="Program.cs not found in @(Compile) before CoreCompile for SeatSync.Api. Check upstream MSBuild imports." />
  </Target>

  <!--
    Razor-specific sanitization for literal wildcard identities leaked into
    Razor item groups in CI.
  -->
  <Target Name="SanitizeInvalidLiteralRazorItems" BeforeTargets="RazorCoreCompile">
    <ItemGroup>
      <_InvalidRazorCompileItems Include="@(RazorCompile)"
                                 Condition="('%(RazorCompile.Identity)' == '**/*.razor'
                                             or '%(RazorCompile.Identity)' == '**\*.razor'
                                             or '%(RazorCompile.Identity)' == '**/*.cshtml'
                                             or '%(RazorCompile.Identity)' == '**\*.cshtml')
                                            and !Exists('%(RazorCompile.FullPath)')" />

      <_InvalidRazorGenerateItems Include="@(RazorGenerate)"
                                  Condition="('%(RazorGenerate.Identity)' == '**/*.razor'
                                              or '%(RazorGenerate.Identity)' == '**\*.razor'
                                              or '%(RazorGenerate.Identity)' == '**/*.cshtml'
                                              or '%(RazorGenerate.Identity)' == '**\*.cshtml')
                                             and !Exists('%(RazorGenerate.FullPath)')" />

      <RazorCompile Remove="@(_InvalidRazorCompileItems)" />
      <RazorGenerate Remove="@(_InvalidRazorGenerateItems)" />
    </ItemGroup>

    <Message Importance="high"
             Condition="'@(_InvalidRazorCompileItems)' != '' or '@(_InvalidRazorGenerateItems)' != ''"
             Text="Sanitized invalid literal razor items. Compile: @(_InvalidRazorCompileItems, ', ') | Generate: @(_InvalidRazorGenerateItems, ', ')" />
  </Target>
</Project>
