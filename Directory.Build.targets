<Project>
  <!--
    Intentionally present to stop MSBuild from searching parent folders for
    Directory.Build.targets on CI agents.
  -->

  <!--
    Defensive CI hardening for leaked literal wildcard items.
    Some CI import chains can leak identities like **/*.cs, **/*.razor, **/*.cshtml,
    or **/* into item groups as literal strings. Roslyn/Razor then treat these as
    file paths and fail with CS2021/CS2001.
  -->
  <Target Name="SanitizeInvalidLiteralWildcardItems"
          BeforeTargets="BeforeBuild;CoreCompile;RazorCoreCompile">
    <ItemGroup>
      <!-- Only sanitize Compile for non-Web SDK projects. In Web SDK projects,
           Compile may legitimately be represented as **/*.cs at this stage. -->
      <_InvalidCompileItems Include="@(Compile)"
                            Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'
                                       and ('%(Compile.Identity)' == '**/*.cs'
                                            or '%(Compile.Identity)' == '**\*.cs'
                                            or '%(Compile.Identity)' == '**/*.razor'
                                            or '%(Compile.Identity)' == '**\*.razor'
                                            or '%(Compile.Identity)' == '**/*.cshtml'
                                            or '%(Compile.Identity)' == '**\*.cshtml'
                                            or '%(Compile.Identity)' == '**/*'
                                            or '%(Compile.Identity)' == '**\*')" />
      <_SanitizedCompile Include="@(Compile)"
                         Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'
                                    and '%(Compile.Identity)' != '**/*.cs'
                                    and '%(Compile.Identity)' != '**\*.cs'
                                    and '%(Compile.Identity)' != '**/*.razor'
                                    and '%(Compile.Identity)' != '**\*.razor'
                                    and '%(Compile.Identity)' != '**/*.cshtml'
                                    and '%(Compile.Identity)' != '**\*.cshtml'
                                    and '%(Compile.Identity)' != '**/*'
                                    and '%(Compile.Identity)' != '**\*'" />
      <Compile Remove="@(Compile)"
               Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
      <Compile Include="@(_SanitizedCompile)"
               Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />

      <_InvalidContentItems Include="@(Content)"
                            Condition="'%(Content.Identity)' == '**/*.cs'
                                       or '%(Content.Identity)' == '**\*.cs'
                                       or '%(Content.Identity)' == '**/*.razor'
                                       or '%(Content.Identity)' == '**\*.razor'
                                       or '%(Content.Identity)' == '**/*.cshtml'
                                       or '%(Content.Identity)' == '**\*.cshtml'
                                       or '%(Content.Identity)' == '**/*.json'
                                       or '%(Content.Identity)' == '**\*.json'
                                       or '%(Content.Identity)' == '**/*.config'
                                       or '%(Content.Identity)' == '**\*.config'
                                       or '%(Content.Identity)' == '**/*'
                                       or '%(Content.Identity)' == '**\*'" />
      <_SanitizedContent Include="@(Content)"
                         Condition="'%(Content.Identity)' != '**/*.cs'
                                    and '%(Content.Identity)' != '**\*.cs'
                                    and '%(Content.Identity)' != '**/*.razor'
                                    and '%(Content.Identity)' != '**\*.razor'
                                    and '%(Content.Identity)' != '**/*.cshtml'
                                    and '%(Content.Identity)' != '**\*.cshtml'
                                    and '%(Content.Identity)' != '**/*.json'
                                    and '%(Content.Identity)' != '**\*.json'
                                    and '%(Content.Identity)' != '**/*.config'
                                    and '%(Content.Identity)' != '**\*.config'
                                    and '%(Content.Identity)' != '**/*'
                                    and '%(Content.Identity)' != '**\*'" />
      <Content Remove="@(Content)" />
      <Content Include="@(_SanitizedContent)" />

      <_InvalidNoneItems Include="@(None)"
                         Condition="'%(None.Identity)' == '**/*.cs'
                                    or '%(None.Identity)' == '**\*.cs'
                                    or '%(None.Identity)' == '**/*.razor'
                                    or '%(None.Identity)' == '**\*.razor'
                                    or '%(None.Identity)' == '**/*.cshtml'
                                    or '%(None.Identity)' == '**\*.cshtml'
                                    or '%(None.Identity)' == '**/*.json'
                                    or '%(None.Identity)' == '**\*.json'
                                    or '%(None.Identity)' == '**/*.config'
                                    or '%(None.Identity)' == '**\*.config'
                                    or '%(None.Identity)' == '**/*'
                                    or '%(None.Identity)' == '**\*'" />
      <_SanitizedNone Include="@(None)"
                      Condition="'%(None.Identity)' != '**/*.cs'
                                 and '%(None.Identity)' != '**\*.cs'
                                 and '%(None.Identity)' != '**/*.razor'
                                 and '%(None.Identity)' != '**\*.razor'
                                 and '%(None.Identity)' != '**/*.cshtml'
                                 and '%(None.Identity)' != '**\*.cshtml'
                                 and '%(None.Identity)' != '**/*.json'
                                 and '%(None.Identity)' != '**\*.json'
                                 and '%(None.Identity)' != '**/*.config'
                                 and '%(None.Identity)' != '**\*.config'
                                 and '%(None.Identity)' != '**/*'
                                 and '%(None.Identity)' != '**\*'" />
      <None Remove="@(None)" />
      <None Include="@(_SanitizedNone)" />

      <_InvalidRazorCompileItems Include="@(RazorCompile)"
                                 Condition="'%(RazorCompile.Identity)' == '**/*.cs'
                                            or '%(RazorCompile.Identity)' == '**\*.cs'
                                            or '%(RazorCompile.Identity)' == '**/*.razor'
                                            or '%(RazorCompile.Identity)' == '**\*.razor'
                                            or '%(RazorCompile.Identity)' == '**/*.cshtml'
                                            or '%(RazorCompile.Identity)' == '**\*.cshtml'
                                            or '%(RazorCompile.Identity)' == '**/*'
                                            or '%(RazorCompile.Identity)' == '**\*'" />
      <_SanitizedRazorCompile Include="@(RazorCompile)"
                              Condition="'%(RazorCompile.Identity)' != '**/*.cs'
                                         and '%(RazorCompile.Identity)' != '**\*.cs'
                                         and '%(RazorCompile.Identity)' != '**/*.razor'
                                         and '%(RazorCompile.Identity)' != '**\*.razor'
                                         and '%(RazorCompile.Identity)' != '**/*.cshtml'
                                         and '%(RazorCompile.Identity)' != '**\*.cshtml'
                                         and '%(RazorCompile.Identity)' != '**/*'
                                         and '%(RazorCompile.Identity)' != '**\*'" />
      <RazorCompile Remove="@(RazorCompile)" />
      <RazorCompile Include="@(_SanitizedRazorCompile)" />

      <_InvalidRazorGenerateItems Include="@(RazorGenerate)"
                                  Condition="'%(RazorGenerate.Identity)' == '**/*.cs'
                                             or '%(RazorGenerate.Identity)' == '**\*.cs'
                                             or '%(RazorGenerate.Identity)' == '**/*.razor'
                                             or '%(RazorGenerate.Identity)' == '**\*.razor'
                                             or '%(RazorGenerate.Identity)' == '**/*.cshtml'
                                             or '%(RazorGenerate.Identity)' == '**\*.cshtml'
                                             or '%(RazorGenerate.Identity)' == '**/*'
                                             or '%(RazorGenerate.Identity)' == '**\*'" />
      <_SanitizedRazorGenerate Include="@(RazorGenerate)"
                               Condition="'%(RazorGenerate.Identity)' != '**/*.cs'
                                          and '%(RazorGenerate.Identity)' != '**\*.cs'
                                          and '%(RazorGenerate.Identity)' != '**/*.razor'
                                          and '%(RazorGenerate.Identity)' != '**\*.razor'
                                          and '%(RazorGenerate.Identity)' != '**/*.cshtml'
                                          and '%(RazorGenerate.Identity)' != '**\*.cshtml'
                                          and '%(RazorGenerate.Identity)' != '**/*'
                                          and '%(RazorGenerate.Identity)' != '**\*'" />
      <RazorGenerate Remove="@(RazorGenerate)" />
      <RazorGenerate Include="@(_SanitizedRazorGenerate)" />
    </ItemGroup>

    <Message Importance="high"
             Condition="'@(_InvalidCompileItems)' != ''
                        or '@(_InvalidContentItems)' != ''
                        or '@(_InvalidNoneItems)' != ''
                        or '@(_InvalidRazorCompileItems)' != ''
                        or '@(_InvalidRazorGenerateItems)' != ''"
             Text="Sanitized invalid literal wildcard identities. Compile: @(_InvalidCompileItems, ', ') | Content: @(_InvalidContentItems, ', ') | None: @(_InvalidNoneItems, ', ') | RazorCompile: @(_InvalidRazorCompileItems, ', ') | RazorGenerate: @(_InvalidRazorGenerateItems, ', ')" />
  </Target>
</Project>
