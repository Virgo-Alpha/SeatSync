<Project>
  <!--
    Intentionally present to stop MSBuild from searching parent folders for
    Directory.Build.targets on CI agents.
  -->

  <!--
    Defensive CI hardening for leaked literal wildcard items.
    Some CI import chains can leak identities like **/*.cs, **/*.razor, **/*.cshtml,
    or **/* into item groups as literal strings. Roslyn/Razor then treat these as
    file paths and fail with CS2021/CS2001.
  -->
  <Target Name="SanitizeInvalidLiteralWildcardItems"
          BeforeTargets="BeforeBuild;CoreCompile;RazorCoreCompile">
    <ItemGroup>
      <!-- Remove escaped literals so wildcard text is treated as exact identity, not a glob. -->
      <Compile Remove="$([MSBuild]::Escape('**/*.cs'))" />
      <Compile Remove="$([MSBuild]::Escape('**\*.cs'))" />
      <Compile Remove="$([MSBuild]::Escape('**/*.razor'))" />
      <Compile Remove="$([MSBuild]::Escape('**\*.razor'))" />
      <Compile Remove="$([MSBuild]::Escape('**/*.cshtml'))" />
      <Compile Remove="$([MSBuild]::Escape('**\*.cshtml'))" />
      <Compile Remove="$([MSBuild]::Escape('**/*'))" />
      <Compile Remove="$([MSBuild]::Escape('**\*'))" />

      <Content Remove="$([MSBuild]::Escape('**/*.cs'))" />
      <Content Remove="$([MSBuild]::Escape('**\*.cs'))" />
      <Content Remove="$([MSBuild]::Escape('**/*.razor'))" />
      <Content Remove="$([MSBuild]::Escape('**\*.razor'))" />
      <Content Remove="$([MSBuild]::Escape('**/*.cshtml'))" />
      <Content Remove="$([MSBuild]::Escape('**\*.cshtml'))" />
      <Content Remove="$([MSBuild]::Escape('**/*.json'))" />
      <Content Remove="$([MSBuild]::Escape('**\*.json'))" />
      <Content Remove="$([MSBuild]::Escape('**/*.config'))" />
      <Content Remove="$([MSBuild]::Escape('**\*.config'))" />
      <Content Remove="$([MSBuild]::Escape('**/*'))" />
      <Content Remove="$([MSBuild]::Escape('**\*'))" />

      <None Remove="$([MSBuild]::Escape('**/*.cs'))" />
      <None Remove="$([MSBuild]::Escape('**\*.cs'))" />
      <None Remove="$([MSBuild]::Escape('**/*.razor'))" />
      <None Remove="$([MSBuild]::Escape('**\*.razor'))" />
      <None Remove="$([MSBuild]::Escape('**/*.cshtml'))" />
      <None Remove="$([MSBuild]::Escape('**\*.cshtml'))" />
      <None Remove="$([MSBuild]::Escape('**/*.json'))" />
      <None Remove="$([MSBuild]::Escape('**\*.json'))" />
      <None Remove="$([MSBuild]::Escape('**/*.config'))" />
      <None Remove="$([MSBuild]::Escape('**\*.config'))" />
      <None Remove="$([MSBuild]::Escape('**/*'))" />
      <None Remove="$([MSBuild]::Escape('**\*'))" />

      <RazorCompile Remove="$([MSBuild]::Escape('**/*.cs'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**\*.cs'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**/*.razor'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**\*.razor'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**/*.cshtml'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**\*.cshtml'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**/*'))" />
      <RazorCompile Remove="$([MSBuild]::Escape('**\*'))" />

      <RazorGenerate Remove="$([MSBuild]::Escape('**/*.cs'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**\*.cs'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**/*.razor'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**\*.razor'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**/*.cshtml'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**\*.cshtml'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**/*'))" />
      <RazorGenerate Remove="$([MSBuild]::Escape('**\*'))" />
    </ItemGroup>

    <Message Importance="high"
             Text="Sanitized known invalid literal wildcard identities from MSBuild item groups." />
  </Target>
</Project>
