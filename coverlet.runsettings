<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>
            **/Migrations/*.cs,
            **/*.Designer.cs,
            **/obj/**/*.cs,
            **/bin/**/*.cs,
            **/*generated*.cs,
            **/Program.cs,
            **/*.razor,
            **/WeatherForecast.cs,
            **/ExampleJsInterop.cs,
            **/ReservationStoredProcedureService.cs,
            **/Models/Api/*.cs,
            **/Contracts/**/*.cs
          </ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
