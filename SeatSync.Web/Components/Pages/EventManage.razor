@page "/events/manage"
@rendermode InteractiveServer
@inject ISeatSyncApiClient ApiClient
@inject IUserSessionService Session
@inject NavigationManager Nav

<PageTitle>Manage Events</PageTitle>

<h1>Manage Events</h1>

@if (!Session.IsAuthenticated)
{
    <p class="text-danger">You must login first.</p>
    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("/login"))">Login</button>
}
else if (!(Session.IsInRole("Admin") || Session.IsInRole("Organizer")))
{
    <p class="text-danger">Only admins and organizers can create events.</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="CreateEventAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Event Name</label>
            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>

        <div class="mb-3">
            <label>Date and Time (UTC)</label>
            <InputText class="form-control" type="datetime-local" @bind-Value="_model.StartsAtLocal" />
        </div>

        <div class="mb-3">
            <label>Agenda (optional)</label>
            <InputTextArea class="form-control" @bind-Value="_model.Agenda" />
        </div>

        <button class="btn btn-success" type="submit" disabled="@_isSaving">
            @(_isSaving ? "Creating..." : "Create Event")
        </button>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(_status))
{
    <p class="mt-3">@_status</p>
}

@code {
    private readonly CreateEventFormModel _model = new()
    {
        StartsAtLocal = DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-ddTHH:mm")
    };
    private bool _isSaving;
    private string _status = string.Empty;

    private async Task CreateEventAsync()
    {
        _isSaving = true;
        _status = string.Empty;

        try
        {
            if (!DateTime.TryParse(_model.StartsAtLocal, out var parsedLocal))
            {
                _status = "Please enter a valid event date/time.";
                return;
            }

            var startsAtUtc = DateTime.SpecifyKind(parsedLocal, DateTimeKind.Utc);
            var result = await ApiClient.CreateEventAsync(
                _model.Name,
                new DateTimeOffset(startsAtUtc),
                _model.Agenda,
                null,
                CancellationToken.None);

            _status = result is null
                ? "Failed to create event."
                : $"Created event '{result.Name}' on {result.StartsAt:yyyy-MM-dd HH:mm} UTC.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class CreateEventFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string StartsAtLocal { get; set; } = string.Empty;
        public string? Agenda { get; set; }
    }
}
