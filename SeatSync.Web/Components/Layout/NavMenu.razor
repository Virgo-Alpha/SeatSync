@implements IDisposable
@inject IUserSessionService Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SeatSync</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="events">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Seat Booking
            </NavLink>
        </div>

        @if (Session.IsInRole("Admin") || Session.IsInRole("Organizer"))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/events">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Manage Events
                </NavLink>
            </div>
        }

        @if (!Session.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logout">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Logout
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += HandleSessionChanged;
    }

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);
}
